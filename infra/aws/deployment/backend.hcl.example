# Only after separate state-bootstrap approval and execution; no credentials.
bucket              = "fata-offline-state"
key                 = "ec2-demo/terraform.tfstate"
region              = "us-east-1"
encrypt             = true
use_lockfile        = true
allowed_account_ids = ["000000000000"]
workspace_key_prefix = "env:"
max_retries          = 1
retry_mode           = "standard"
