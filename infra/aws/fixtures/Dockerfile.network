# Test-only namespace controller, never an application/deployment image.
FROM python:3.14.9-slim-bookworm@sha256:945c2676dc2b18e0c1f16879244122c57c0ffede60006bf3df159c507a31bcae
RUN apt-get update && apt-get install -y --no-install-recommends iptables iproute2 && rm -rf /var/lib/apt/lists/*
ENTRYPOINT ["python", "/source/infra/aws/fixtures/network_probe.py"]
